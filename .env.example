# Copy to .env (make setup does this) and fill in. .env is gitignored — never commit it.

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Cloudflare dashboard -> Workers AI -> Use REST API (account ID + a token with Workers AI permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Model IDs. Check the exact names in AI Studio and the Cloudflare model catalogue;
# `make smoke` fails fast and lists close matches if one is wrong.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.8-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CF_IMAGE_STEPS=4
# Set to true only if the image model's input schema accepts a seed.
CF_IMAGE_SEND_SEED=false

# Wan 2.2 TI2V-5B output size: 1280*704 (horizontal) or 704*1280 (vertical)
WAN_SIZE=1280*704


curl \
  https://api.cloudflare.com/client/v4/accounts/62e38740a6a2d2fd5ebf0834d7b2c4ff/ai/run/@cf/moonshotai/kimi-k2.7-code \
  -H "Authorization: Bearer {API_TOKEN}" \
  -d '{"messages":[{"role":"system","content":"You are a friendly assistant that helps write stories"},{"role":"user","content":"Write a short story about a llama that goes on a journey to find an orange cloud "}]}'

  import requests

API_BASE_URL = "https://api.cloudflare.com/client/v4/accounts/62e38740a6a2d2fd5ebf0834d7b2c4ff/ai/run/"
headers = {"Authorization": "Bearer {API_TOKEN}"}

def run(model, inputs):
    input = { "messages": inputs }
    response = requests.post(f"{API_BASE_URL}{model}", headers=headers, json=input)
    return response.json()

inputs = [
    { "role": "system", "content": "You are a friendly assistan that helps write stories" },
    { "role": "user", "content": "Write a short story about a llama that goes on a journey to find an orange cloud "}
];
output = run("@cf/moonshotai/kimi-k2.7-code", inputs)
print(output)

