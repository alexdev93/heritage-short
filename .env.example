# Copy to .env (make setup does this) and fill in. .env is gitignored — never commit it.

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Cloudflare dashboard -> Workers AI -> Use REST API (account ID + a token with Workers AI permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Model IDs. Check the exact names in AI Studio and the Cloudflare model catalogue;
# `make smoke` fails fast and lists close matches if one is wrong.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.8-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CF_IMAGE_STEPS=4
# Set to true only if the image model's input schema accepts a seed.
CF_IMAGE_SEND_SEED=false

# Wan 2.2 TI2V-5B output size: 1280*704 (horizontal) or 704*1280 (vertical)
WAN_SIZE=1280*704
